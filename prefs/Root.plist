<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>GlowIconPosition</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>GlowIconPosition</string>
			<key>footerText</key>
			<string>Move all of Glow’s notification icons up or down together. The date, time and battery widgets stay in place.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Icon position</string>
			<key>footerText</key>
			<string>0 keeps the original working position. Negative values move up; positive values move down. Changes apply the next time Glow appears, without a respring. Position is limited at the screen edges.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>Current offset</string>
			<key>get</key>
			<string>currentPosition:</string>
			<key>id</key>
			<string>CURRENT_POSITION</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Vertical offset</string>
			<key>defaults</key>
			<string>com.551.glowiconposition</string>
			<key>key</key>
			<string>verticalOffset</string>
			<key>default</key>
			<integer>0</integer>
			<key>min</key>
			<integer>-75</integer>
			<key>max</key>
			<integer>700</integer>
			<key>showValue</key>
			<true/>
			<key>id</key>
			<string>POSITION_SLIDER</string>
			<key>PostNotification</key>
			<string>com.551.glowiconposition/settingsChanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Move up 10 pt</string>
			<key>action</key>
			<string>moveUp</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Move down 10 pt</string>
			<key>action</key>
			<string>moveDown</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Reset to default position</string>
			<key>action</key>
			<string>resetPosition</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>About</string>
			<key>footerText</key>
			<string>Requires Glow. Made by 551.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>GitHub repository</string>
			<key>action</key>
			<string>openGitHub</string>
		</dict>
	</array>
</dict>
</plist>
