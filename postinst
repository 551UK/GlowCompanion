#!/var/jb/bin/sh
# Request Sileo/Cydia's completion button only after successful configuration.
[ "$1" = configure ] || exit 0

# Glow keeps this page inside its actual PreferenceBundle (capital G).
# Older builds incorrectly targeted PreferenceLoader/glow.bundle.
glow_icons_plist=/var/jb/Library/PreferenceBundles/Glow.bundle/NotificationIcons.plist
legacy_icons_plist=/var/jb/Library/PreferenceLoader/glow.bundle/NotificationIcons.plist
patcher=/var/jb/usr/libexec/GlowIconPosition/GlowPrefsPatch

if [ -x "$patcher" ]; then
    if [ -f "$glow_icons_plist" ]; then
        "$patcher" "$glow_icons_plist" >/dev/null 2>&1 || true
    elif [ -f "$legacy_icons_plist" ]; then
        "$patcher" "$legacy_icons_plist" >/dev/null 2>&1 || true
    fi
fi

# Close cached Settings so it reloads Glow's updated slider specifier.
if [ -x /var/jb/usr/bin/killall ]; then
    /var/jb/usr/bin/killall Preferences >/dev/null 2>&1 || true
fi

channel=${SILEO:-${CYDIA:-}}
[ -n "$channel" ] || exit 0
read -r control_fd protocol_version extra <<END_CHANNEL
$channel
END_CHANNEL
case "$control_fd" in ''|*[!0-9]*) exit 0 ;; esac
case "$protocol_version" in ''|*[!0-9]*) exit 0 ;; esac
[ "$protocol_version" -ge 1 ] || exit 0
(printf 'finish:restart\n' >&"$control_fd") 2>/dev/null || true
exit 0
